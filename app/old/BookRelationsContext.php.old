<?php
namespace App\Libs\Context;

final class BookRelationsContext {
    /** Book context data from various tables */
    public ?array               $writerIds = null;          // book_writers->writers
    public ?array               $genreIds  = null;          // book_genres->genres
    // Reservation (if any)
    public ?int                 $resvLoanerId  = null;      // book_reservations
    public ?int                 $resvOfficeId  = null;      // book_reservations
    public ?\DateTimeImmutable  $resvCreatedAt = null;      // book_reservations
    public ?\DateTimeImmutable  $resvExpiresAt = null;      // book_reservations
    // Loaner (if any)
    public ?int                 $loanerId      = null;      // book_loaners
    public ?\DateTimeImmutable  $loanStart     = null;      // book_loaners
    public ?\DateTimeImmutable  $loanEnd       = null;      // book_loaners

    /** Construct context based on row data. */
    public function __construct(array $data) {
        // Many-to-many relations
        $this->writerIds = isset($data['writers']) && is_array($data['writers']) ? array_map('intval', $data['writers']) : null;
        $this->genreIds = isset($data['genres']) && is_array($data['genres']) ? array_map('intval', $data['genres']) : null;
        // Reservation (optional)
        $this->resvLoanerId  = isset($data['reservation']['loaner_id']) ? (int)$data['reservation']['loaner_id'] : null;
        $this->resvOfficeId  = isset($data['reservation']['office_id']) ? (int)$data['reservation']['office_id'] : null;
        $this->resvCreatedAt = isset($data['reservation']['created_at']) ? new \DateTimeImmutable($data['reservation']['created_at']) : null;
        $this->resvExpiresAt = isset($data['reservation']['expires_at']) ? new \DateTimeImmutable($data['reservation']['expires_at']) : null;
        // Loan (optional)
        $this->loanerId = isset($data['loan']['loaner_id']) ? (int)$data['loan']['loaner_id'] : null;
        $this->loanStart = isset($data['loan']['start_date']) ? new \DateTimeImmutable($data['loan']['start_date']) : null;
        $this->loanEnd = isset($data['loan']['end_date']) ? new \DateTimeImmutable($data['loan']['end_date']) : null;
    }

    /** API: Return row as context. */
    public static function fromData(array $data): self {
        return new self($data);
    }
}